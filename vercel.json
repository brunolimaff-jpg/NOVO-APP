{
  "installCommand": "npm install --global npm@11.11.0 && npm --version && npm ci",
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 300
    },
    "api/open-web-search.ts": {
      "maxDuration": 60
    },
    "api/extract-content.ts": {
      "maxDuration": 60
    },
    "api/cron-email-confirmation.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-email-confirmation",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
