{
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 300
    },
    "api/radar-scan.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/radar-scan",
      "schedule": "0 7,19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
