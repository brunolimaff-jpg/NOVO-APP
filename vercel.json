{
  "buildCommand": "npm run test && npm run build",
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 300
    },
    "api/radar-scan.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
