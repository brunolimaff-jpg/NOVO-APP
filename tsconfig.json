{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "types.ts",
    "constants.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "components/**/*",
    "hooks/**/*",
    "services/**/*",
    "contexts/**/*",
    "config/**/*",
    "prompts/**/*",
    "utils/**/*",
    "api/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tmp",
    "**/*.cjs",
    "**/*.py",
    "**/*.fixed",
    "**/*.txt"
  ]
}
