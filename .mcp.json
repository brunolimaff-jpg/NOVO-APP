{
  "mcpServers": {
    "deepseek": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "deepseek-mcp-server"],
      "env": {
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=vmqfcaoirjcfucvlnpig",
      "headers": {
        "Authorization": "Bearer {{SUPABASE_PUBLISHABLE_KEY}}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "sentry": {
      "command": "./scripts/sentry-mcp.sh",
      "args": [],
      "type": "stdio"
    }
  }
}
