    "validate:prompts": "bash scripts/validate-prompts.sh",
    "validate:preview": "bash scripts/validate-preview.sh",
    "lint": "eslint .",
    "analyze:circular": "madge --circular . --extensions ts,tsx --exclude '^(node_modules|dist|\\.next|public)'",
    "analyze:deadcode": "ts-prune",
    "format": "prettier --write '**/*.{ts,tsx,json,css}' --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "ingest:pdfdocs": "node --experimental-strip-types scripts/ingestPdfDocs.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
