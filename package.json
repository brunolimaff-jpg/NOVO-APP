{
  "name": "mvp-rodando---scout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:obsidian:check": "node scripts/obsidian/check.mjs",
    "test": "vitest run",
    "test:dossier": "vitest run tests/App.dossierGolden.test.tsx",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests-e2e/smoke.*.spec.ts",
    "test:e2e:smoke:ui": "playwright test tests-e2e/smoke.*.spec.ts --ui",
    "test:e2e:cnpj": "playwright test tests-e2e/cnpj-investigation-flow.spec.ts",
