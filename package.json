    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.2",
    "idb-keyval": "^6.2.1",
    "jspdf": "^4.2.0",
    "langchain": "^1.3.0",
    "mammoth": "^1.12.0",
    "mermaid": "^10.9.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "9",
    "react-virtuoso": "^4.18.3",
    "rehype-raw": "7",
    "remark-breaks": "4",
    "remark-gfm": "4",
    "uuid": "^13.0.0",
