    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "html-encoding-sniffer": "^6.0.0",
    "jsdom": "^29.0.1",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "~5.8.2",
