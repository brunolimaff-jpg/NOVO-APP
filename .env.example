# Environment reference for local development and Vercel.
# Copy this file to .env.local when needed. Never commit real values.
# Any VITE_* variable is included in the browser bundle: never place secrets there.

# Browser: remote storage and authentication client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Browser: public Sentry DSN. On Vercel, SENTRY_DSN may supply the same value at build time.
VITE_SENTRY_DSN=https://your-dsn@o000000.ingest.sentry.io/0000000

# Serverless: Supabase diagnostics and persistent cache. SUPABASE_URL is preferred server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Serverless: optional explicit CORS origin outside automatic Vercel Preview handling.
ALLOWED_ORIGIN=

# Serverless: native Gemini fallback and RAG.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=
GEMINI_OCR_MODEL=

# Serverless: LiteLLM routing. Leave unset to use the documented native-provider path.
LLM_PROVIDER=
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Serverless: search and RAG.
BRAVE_SEARCH_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=
PINECONE_DOCS_KEY=
PINECONE_DOCS_INDEX=
PINECONE_DOCS_NAMESPACE=

# Build-only: Sentry source-map upload. Keep SENTRY_AUTH_TOKEN server-side.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=scout-360
APP_VERSION=

# Local Vite only. API handlers run on Vercel; this proxies browser /api calls to a chosen target.
LOCAL_DEV_API_PROXY_TARGET=https://scoutagro.vercel.app
# Obtain this secret from Vercel only when accessing a protected Preview. Do not share it.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional browser diagnostics. Do not enable verbose logs for routine production use.
VITE_SCOUT_DIAGNOSTICS_ENABLED=
VITE_DEBUG_CONSOLE=
VITE_VERBOSE_LOGS=

# Optional local endpoint overrides for controlled debugging.
VITE_GEMINI_PROXY_URL=
VITE_CNPJ_PROXY_URL=
VITE_OPEN_WEB_SEARCH_URL=
VITE_BACKEND_URL=
VITE_LOOKUP_URL=
