# Senior Scout 360 — Environment Variables
# Copy to .env.local for local development.
# DO NOT COMMIT SECRETS.
#
# URLs de projetos Supabase e chaves anon NÃO são segredos (são públicas
# por design no modelo Supabase), mas usamos placeholders aqui para evitar
# acoplamento do template a um ambiente específico. Substitua pelos valores
# do ambiente que você quer apontar (local, Preview ou Produção).

# === Supabase ===
# URL pública do projeto (local via `supabase start`, Preview/Produção via Vercel).
# Não é segredo: o client precisa dela para abrir a conexão.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Chave anon (JWT público, não publishable). Não é segredo, mas NUNCA use a
# service_role no frontend.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === LLM Gateway (LiteLLM) — server-side ===
# LLM_PROVIDER controla o roteamento SERVER-SIDE em api/_llm-client.ts.
# NÃO tem prefixo VITE_ — não é lido pelo browser.
LLM_PROVIDER=litellm
# Chave de acesso ao gateway LiteLLM (segredo — via Vercel env).
LITELLM_API_KEY=
# URL base do gateway LiteLLM.
LITELLM_BASE_URL=https://your-litellm-gateway.example/
# Alias do modelo para geração de dossiê.
LITELLM_DOSSIER_MODEL=scout-dossier-generate
# Teto de retries para o cliente LiteLLM genérico (api/_llm-client.ts).
# O gateway de dossiê usa maxRetries: 0 (ver api/_dossier-llm-gateway.ts).
LITELLM_MAX_RETRIES=1
# Budget de timeout para o cliente genérico (ms). Limitado a 180s internamente.
LITELLM_REQUEST_TIMEOUT_MS=180000
# Budget de timeout específico do gateway de dossiê (ms). Limitado a 50s.
LITELLM_DOSSIER_TIMEOUT_MS=50000

# === Legacy Gemini (ainda usado em fluxos de compatibilidade) ===
# server-side, sem prefixo VITE_.
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=

# === External APIs ===
CNPJABERTO_API_KEY=
BRAVE_API_KEY=
BRAVE_SEARCH_API_KEY=

# === Pinecone (RAG) ===
# process.env.PINECONE_API_KEY (server-side, api/_llm-client.ts, services/ragService.ts)
PINECONE_API_KEY=
# process.env.PINECONE_INDEX (server-side, services/ragService.ts)
PINECONE_INDEX=
# process.env.PINECONE_NAMESPACE (server-side, services/ragService.ts)
PINECONE_NAMESPACE=
# Compatibilidade legado (fallback para docs-specific)
PINECONE_DOCS_INDEX=
PINECONE_DOCS_KEY=

# === Sentry ===
# VITE_SENTRY_DSN é público por design (Vite inlineia no bundle). Lido por
# index.tsx para habilitar a captura de erros no client.
VITE_SENTRY_DSN=https://your-dsn@oXXXXXX.ingest.sentry.io/XXXXXXX
# Variáveis server-side (sem VITE_) para o build plugin (@sentry/vite-plugin).
# SENTRY_AUTH_TOKEN NUNCA deve ser commitado — manter em ~/.zshenv ou Vercel.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=scout-360

# === Vercel ===
VERCEL=1
# VITE_VERCEL_GIT_COMMIT_SHA é injetado automaticamente pelo Vercel em runtime.
# VERCEL_AUTOMATION_BYPASS_SECRET: usado em testes E2E e vite.config.ts para
# bypass de proteção de Preview (x-vercel-protection-bypass). Opcional.
VERCEL_AUTOMATION_BYPASS_SECRET=
# VITE_VERBOSE_LOGS e VITE_DEBUG_CONSOLE: desabilitados por padrão.
# Habilitar apenas em ambientes de desenvolvimento/debug controlados.
VITE_VERBOSE_LOGS=false
VITE_DEBUG_CONSOLE=false

# === Feature flags ===
# Todas as flags abaixo são DESABILITADAS por padrão (segurança/estabilidade).
# Habilitar apenas após revisão e aprovação explícita.
VITE_ENABLE_DEEP_DIVE=false
VITE_EVIDENCE_PIPELINE_V2=false
VITE_HYBRID_PIPELINE_ENABLED=0
VITE_GEMINI_FOUNDATION_CACHE_ENABLED=0

# === Local development ===
# Backend Apps Script endpoints (placeholders).
VITE_BACKEND_URL=
VITE_LOOKUP_URL=

# === API Proxies (server-side via Vercel rewrites, client consome via VITE_) ===
# VITE_GEMINI_PROXY_URL: URL do proxy /api/gemini (consumido pelo client).
VITE_GEMINI_PROXY_URL=
# VITE_GEMINI_PROXY_TIMEOUT_MS: timeout do proxy Gemini (ms).
VITE_GEMINI_PROXY_TIMEOUT_MS=30000
# VITE_LLM_PROXY_TIMEOUT_MS: timeout do proxy LLM genérico (ms).
VITE_LLM_PROXY_TIMEOUT_MS=30000
# VITE_CNPJ_PROXY_URL: URL do proxy /api/cnpj (consumido pelo client).
VITE_CNPJ_PROXY_URL=
# VITE_OPEN_WEB_SEARCH_URL: URL do proxy /api/open-web-search.
VITE_OPEN_WEB_SEARCH_URL=

# === Sentry (client) ===
# VITE_SENTRY_RELEASE: release tag (commit SHA). Injetado pelo build Vercel.
VITE_SENTRY_RELEASE=
# VITE_APP_VERSION: versão da aplicação (package.json version).
VITE_APP_VERSION=

# === Dados de demonstração para o Preview ===
# Substitua por placeholders reais do seu ambiente de demo — NUNCA commitar dados reais de cliente.
VITE_PREVIEW_DEMO_CITY=
VITE_PREVIEW_DEMO_CNPJ=
VITE_PREVIEW_DEMO_COMPANY=
VITE_PREVIEW_DEMO_STATE=
# Demo desabilitada por padrão. Habilitar apenas no Preview com dados de demonstração.
VITE_PREVIEW_DEMO_ENABLED=false
# VITE_ENABLE_PREVIEW_DEMO: alias para VITE_PREVIEW_DEMO_ENABLED (compatibilidade).
VITE_ENABLE_PREVIEW_DEMO=false
