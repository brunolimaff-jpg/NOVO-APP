# === Feature flags ===
# Foundation cache de contexto removido (LiteLLM-only). RAG (Pinecone) desabilitado
# até a reindexação autorizada — o endpoint /api/rag responde 503
# RAG_DISABLED_PENDING_REINDEX enquanto RAG_ENABLED !== 'true'.
RAG_ENABLED=false
# OCR de PDF descontinuado (fail-closed): o gateway não expõe modelo de visão.
# Integrar provedor OCR dedicado antes de reativar scripts/ingestPdfDocs.ts.

