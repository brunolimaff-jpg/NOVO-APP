VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Gateway (LiteLLM)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.homolog.seniorlabs.io/
LITELLM_DOSSIER_MODEL=scout-dossier-generate
LITELLM_MAX_RETRIES=2
LITELLM_REQUEST_TIMEOUT_MS=180000

# Legacy Gemini (ainda usado em alguns fluxos de compatibilidade)
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
VITE_LLM_PROVIDER=litellm

# External APIs
CNPJABERTO_API_KEY=
BRAVE_API_KEY=
