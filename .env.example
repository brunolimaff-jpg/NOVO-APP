# Senior Scout 360 — variáveis de ambiente
# Copie para .env (mesmo destino usado no README.md).
# Nunca commite segredos ou valores reais de cliente.
# Referências abaixo apontam para consumidores em origin/main @ 23d6de2e.

# === Supabase — browser ===
# Consumidor: lib/supabaseClient.ts:3
VITE_SUPABASE_URL=https://your-project.supabase.co
# Consumidor: lib/supabaseClient.ts:4
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === Supabase — server-side ===
# Consumidor: services/socio-search/cache.ts:26
SUPABASE_URL=
# Consumidor: api/dossier.ts:120
NEXT_PUBLIC_SUPABASE_URL=
# Consumidor: api/dossier.ts:121
SUPABASE_ANON_KEY=
# Consumidor: api/cron-email-confirmation.ts:5
SUPABASE_SERVICE_ROLE_KEY=

# === LiteLLM — server-side ===
# Consumidor: api/_llm-client.ts:289
LLM_PROVIDER=litellm
# Consumidor: api/_llm-client.ts:293
LLM_FALLBACK_ENABLED=false
# Consumidor: api/_llm-client.ts:289
LITELLM_API_KEY=
# Consumidor: api/_llm-client.ts:289
LITELLM_BASE_URL=https://your-litellm-gateway.example/
# Consumidor: api/_dossier-llm-gateway.ts:38
LITELLM_DOSSIER_MODEL=scout-dossier-generate
# Consumidor: api/_dossier-llm-gateway.ts:39
LITELLM_DOSSIER_CHAT_MODEL=
# Consumidor: api/_llm-client.ts:353
LITELLM_MAX_RETRIES=1
# Consumidor: api/_llm-client.ts:349
LITELLM_REQUEST_TIMEOUT_MS=38000
# Consumidor: api/_llm-client.ts:357
LITELLM_RETRY_BASE_DELAY_MS=500
# Apesar do prefixo legado VITE_, esta variável é lida no handler server-side.
# Consumidor: api/_llm-client.ts:348
VITE_LITELLM_CLIENT_TIMEOUT_MS=120000
# Consumidor: api/_dossier-llm-gateway.ts:32
LITELLM_DOSSIER_TIMEOUT_MS=50000

# === OpenCode Zen — provider secundário (Fallback V1, server-side) ===
# Sem SDK: o cliente usa o mesmo fetch nativo /chat/completions [OI]-compatible.
# Zero retry automático no Zen. Sem VITE_* (nunca expor no bundle).
# Modos:
#   LLM_PROVIDER=zen            → Zen forçado (sem tocar LiteLLM)
#   LLM_PROVIDER=litellm        → LiteLLM primário
#   + LLM_FALLBACK_ENABLED=true → LiteLLM → Zen em falhas elegíveis (allowlist)
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=deepseek-v4-flash
LLM_FALLBACK_ENABLED=false

# === LLM — runtime primário LiteLLM ===
# Sem LITELLM_API_KEY/LITELLM_BASE_URL + LLM_PROVIDER=litellm, e sem Zen
# configurado/forçado, o endpoint /api/llm responde 503 LLM_GATEWAY_DISABLED
# (fail-closed, sem fallback silencioso para terceiro caminho).

