{
  "agent": "claude",
  "project": "senior-scout-360",
  "description": "Copiloto de Inteligência Comercial para Agronegócio — Senior Sistemas",
  "stack": [
    "react",
    "typescript",
    "tailwindcss",
    "vite",
    "gemini",
    "clerk",
    "vercel",
    "pinecone"
  ],
  "language": "pt-BR",
  "rules": [
    "always-read-repo-before-proposing",
    "no-empty-catch",
    "strong-typing",
    "prompts-in-src-prompts"
  ],
  "caliber": {
    "managed": true,
    "version": "1"
  },
  "skills": {
    "auto-load": true,
    "active": [
      "prompt-engineer",
      "prompt-engineering",
      "prompt-engineering-patterns",
      "gemini-api-dev",
      "llm-app-patterns",
      "llm-application-dev-prompt-optimize",
      "react-best-practices",
      "react-patterns",
      "react-state-management",
      "react-ui-patterns",
      "typescript-expert",
      "typescript-advanced-types",
      "tailwind-design-system",
      "cc-skill-frontend-patterns",
      "cc-skill-coding-standards",
      "cc-skill-security-review",
      "cc-skill-backend-patterns",
      "testing-patterns",
      "test-driven-development",
      "error-handling-patterns",
      "security-audit",
      "data-quality-frameworks",
      "performance-profiling",
      "architecture-patterns",
      "api-design-principles"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tokenmiser update --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "npx tokenmiser hook-read 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
