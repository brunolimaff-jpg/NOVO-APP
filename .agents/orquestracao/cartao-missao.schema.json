{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novo-app.local/.agents/orquestracao/cartao-missao.schema.json",
  "title": "Cartão de Missão",
  "description": "Entrada canônica para o planejador determinístico de missões de agente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id",
    "titulo",
    "objetivo",
    "contexto",
    "resultado_esperado",
    "autorizacao",
    "escopo",
    "restricoes",
    "verificacao",
    "evidencias_requeridas",
    "condicoes_parada"
  ],
  "properties": {
    "versao": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "objetivo": {
      "type": "string",
      "minLength": 1
    },
    "contexto": {
      "type": "string"
    },
    "resultado_esperado": {
      "type": "string",
      "minLength": 1
    },
    "autorizacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nivel", "acoes_permitidas", "acoes_solicitadas", "acoes_proibidas"],
      "properties": {
        "nivel": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]
        },
        "acoes_permitidas": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "acoes_solicitadas": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "acoes_proibidas": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "escopo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leitura", "escrita"],
      "properties": {
        "leitura": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "escrita": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "restricoes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "verificacao": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidencias_requeridas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "condicoes_parada": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "ferramentas_permitidas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["claude-code", "codex", "cursor", "cline", "cline-ide", "cline-cli-sdk-kanban", "opencode"]
      },
      "uniqueItems": true
    },
    "skills_solicitadas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "papel_preferido": {
      "type": "string",
      "enum": [
        "explorador",
        "investigador-incidentes",
        "planejador-solucao",
        "executor-escopo",
        "revisor-contratos",
        "validador-entrega",
        "revisor-evidencias-dossie"
      ]
    },
    "rede_permitida": { "type": "boolean" },
    "shell_permitido": { "type": "boolean" },
    "delegacao_permitida": { "type": "boolean" },
    "fluxo_solicitado": {
      "type": "string"
    },
    "instrucao_atual": {
      "type": "string"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comandos"],
      "properties": {
        "comandos": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "simplicidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reutiliza_existente", "nova_dependencia", "nova_abstracao"],
      "properties": {
        "reutiliza_existente": { "type": "boolean" },
        "nova_dependencia": { "type": "boolean" },
        "nova_abstracao": { "type": "boolean" }
      }
    },
    "execucao_planejada": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estrategia": {
          "type": "string",
          "enum": ["agente-unico", "multiagente"]
        },
        "justificativa_multiagente": { "type": ["string", "null"] },
        "ganho_esperado": { "type": ["string", "null"] },
        "perfil_execucao": {
          "type": "string",
          "enum": ["minimal-change", "padrao"]
        },
        "gate_qualidade": {
          "type": "string",
          "enum": ["evidence-first", "padrao"]
        },
        "agentes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "papel", "permissao", "depende_de"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "papel": { "type": "string", "minLength": 1 },
              "permissao": {
                "type": "string",
                "enum": ["read-only", "workspace-write"]
              },
              "depende_de": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        },
        "tarefas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "agente", "objetivo", "entrega_esperada", "nao_fazer", "arquivos", "depende_de"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "agente": { "type": "string", "minLength": 1 },
              "objetivo": { "type": "string", "minLength": 1 },
              "entrega_esperada": { "type": "string", "minLength": 1 },
              "nao_fazer": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "arquivos": {
                "type": "object",
                "additionalProperties": false,
                "required": ["leitura", "escrita"],
                "properties": {
                  "leitura": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "escrita": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "depende_de": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        },
        "limites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_agentes": { "type": "integer", "minimum": 1 },
            "max_paralelo": { "type": "integer", "minimum": 1, "maximum": 2 },
            "max_tempo_segundos": { "type": "integer", "minimum": 1 },
            "max_retentativas": { "type": "integer", "minimum": 0 },
            "max_rodadas_revisao": { "type": "integer", "minimum": 0 },
            "permite_subdelegacao": { "type": "boolean" }
          }
        }
      }
    }
  }
}
