{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relatório de Execução Controlada",
  "type": "object",
  "required": [
    "versao",
    "missao_id",
    "plan_hash",
    "modo",
    "status",
    "inicio",
    "fim",
    "duracao_ms",
    "comandos",
    "negacoes",
    "avisos",
    "evidencias"
  ],
  "additionalProperties": false,
  "properties": {
    "versao": { "type": "integer", "const": 1 },
    "missao_id": { "type": "string", "minLength": 1 },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safety_report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relatorio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planned_snapshot": { "type": "object", "additionalProperties": true },
    "planned_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_snapshot": { "type": "object", "additionalProperties": true },
    "observed_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "comparacao": {
      "type": "object",
      "required": ["status", "itens"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["conforme", "desvio", "violacao", "indisponivel"] },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["campo", "esperado", "observado", "resultado", "severidade", "codigo", "mensagem"],
            "additionalProperties": false,
            "properties": {
              "campo": { "type": "string" },
              "esperado": {},
              "observado": {},
              "resultado": { "type": "string", "enum": ["conforme", "desvio", "violacao", "indisponivel"] },
              "severidade": { "type": "string" },
              "codigo": { "type": ["string", "null"] },
              "mensagem": { "type": "string" }
            }
          }
        }
      }
    },
    "task_ledger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "missao_id",
          "agente_id",
          "papel",
          "status",
          "inicio",
          "fim",
          "tentativa",
          "input_refs",
          "output_refs",
          "dependencia_ids",
          "codigo_final",
          "evidencia_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": { "type": "string" },
          "missao_id": { "type": "string" },
          "agente_id": { "type": "string" },
          "papel": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planned", "authorized", "running", "succeeded", "failed", "denied", "timeout", "unavailable"]
          },
          "inicio": { "type": "string" },
          "fim": { "type": ["string", "null"] },
          "tentativa": { "type": "integer", "const": 1 },
          "input_refs": { "type": "array", "items": { "type": "string" } },
          "output_refs": { "type": "array", "items": { "type": "string" } },
          "dependencia_ids": { "type": "array", "maxItems": 0 },
          "codigo_final": { "type": ["string", "null"] },
          "evidencia_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "resultado_dimensoes": {
      "type": "object",
      "required": ["execution", "delivery", "compliance"],
      "additionalProperties": false,
      "properties": {
        "execution": { "type": "string", "enum": ["succeeded", "failed", "timeout", "unavailable"] },
        "delivery": { "type": "string", "enum": ["succeeded", "failed", "unknown"] },
        "compliance": { "type": "string", "enum": ["conforme", "violacao", "indisponivel"] }
      }
    },
    "delivery_verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "path", "expected_sha256", "observed_sha256", "expected_bytes", "observed_bytes"],
      "properties": {
        "status": { "type": "string", "enum": ["succeeded", "missing", "mismatch", "unavailable"] },
        "path": { "type": "string" },
        "expected_sha256": { "type": "string" },
        "observed_sha256": { "type": ["string", "null"] },
        "expected_bytes": { "type": "integer" },
        "observed_bytes": { "type": "integer" },
        "codigo": { "type": ["string", "null"] }
      }
    },
    "forensic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_status", "manifest_relpath", "manifest_sha256", "schema_version", "limitations"],
      "properties": {
        "evidence_status": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
        "manifest_relpath": { "type": "string", "pattern": "^[^/].*evidence-manifest\\.json$" },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_version": { "type": "integer", "const": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "origem",
        "destino",
        "missao_id",
        "task_id",
        "estado_atual",
        "resumo",
        "arquivos_modificados",
        "evidencias",
        "comparacao_status",
        "violacoes",
        "avisos",
        "proxima_acao_recomendada",
        "requer_aprovacao_humana"
      ],
      "additionalProperties": false,
      "properties": {
        "origem": { "type": "string", "const": "runtime-codex" },
        "destino": { "type": "string", "const": "revisor-humano" },
        "missao_id": { "type": "string" },
        "task_id": { "type": "string" },
        "estado_atual": { "type": "string" },
        "resumo": { "type": "string" },
        "arquivos_modificados": { "type": "array", "items": { "type": "string" } },
        "evidencias": { "type": "array", "items": { "type": "string" } },
        "comparacao_status": { "type": "string" },
        "violacoes": { "type": "array", "items": { "type": "string" } },
        "avisos": { "type": "array", "items": { "type": "string" } },
        "proxima_acao_recomendada": {
          "type": "string",
          "enum": [
            "revisar_diff",
            "corrigir_manualmente",
            "descartar_worktree",
            "autorizar_commit_manual",
            "investigar_violacao",
            "nenhuma_acao"
          ]
        },
        "requer_aprovacao_humana": { "type": "boolean", "const": true }
      }
    },
    "modo": { "type": "string", "enum": ["dry-run", "execute", "agent-runtime"] },
    "status": {
      "type": "string",
      "enum": ["dry-run", "success", "failure", "denied", "timeout", "internal-error", "unavailable"]
    },
    "inicio": { "type": "string" },
    "fim": { "type": "string" },
    "duracao_ms": { "type": "integer", "minimum": 0 },
    "comandos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "executado",
          "exit_code",
          "timeout",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_truncado",
          "stderr_truncado"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "argv": { "type": "array", "items": { "type": "string" } },
          "executado": { "type": "boolean" },
          "exit_code": { "type": ["integer", "null"] },
          "timeout": { "type": "boolean" },
          "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "stdout_truncado": { "type": "boolean" },
          "stderr_truncado": { "type": "boolean" }
        }
      }
    },
    "negacoes": { "type": "array", "items": { "type": "string" } },
    "avisos": { "type": "array", "items": { "type": "string" } },
    "evidencias": { "type": "array", "items": { "type": "string" } },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "motor": { "type": "string" },
        "codex_version": { "type": "string" },
        "dcg_version": { "type": ["string", "null"] },
        "worktree": { "type": "string" },
        "branch": { "type": "string" },
        "head_inicial": { "type": "string" },
        "head_final": { "type": ["string", "null"] },
        "agente_planejado": { "type": "integer" },
        "agente_observado": { "type": "integer" },
        "writers_planejados": { "type": "integer" },
        "processos_iniciados": { "type": "integer" },
        "processo_codex_iniciado": { "type": "boolean" },
        "comandos_catalogo_executados": { "type": "boolean", "const": false },
        "timeout": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "sinal": { "type": ["integer", "null"] },
        "stdout_sha256": { "type": "string" },
        "stderr_sha256": { "type": "string" },
        "stdout_truncado": { "type": "boolean" },
        "stderr_truncado": { "type": "boolean" },
        "arquivos_permitidos": { "type": "array", "items": { "type": "string" } },
        "arquivos_modificados": { "type": "array", "items": { "type": "string" } },
        "violacoes_escopo": { "type": "array", "items": { "type": "string" } },
        "arquivos_protegidos_alterados": { "type": "array", "items": { "type": "string" } },
        "argv": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
