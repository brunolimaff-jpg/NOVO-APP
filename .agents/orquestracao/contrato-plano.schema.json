{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novo-app.local/.agents/orquestracao/contrato-plano.schema.json",
  "title": "Contrato do Plano de Execução",
  "description": "Saída determinística do planejador de missões (Fase 3B.2A: topologia mínima + comandos).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "missao_id",
    "status",
    "papel_principal",
    "ferramenta_selecionada",
    "adaptador_selecionado",
    "skills_selecionadas",
    "autorizacao_fornecida",
    "autorizacao_necessaria",
    "leitura_permitida",
    "escrita_permitida",
    "shell_permitido",
    "rede_permitida",
    "delegacao_permitida",
    "etapas",
    "condicoes_parada",
    "evidencias_requeridas",
    "negacoes",
    "avisos",
    "fontes_decisao",
    "acoes_solicitadas",
    "acoes_permitidas",
    "comandos",
    "resumo_operacional",
    "topologia",
    "simplicidade",
    "limites"
  ],
  "properties": {
    "versao": {
      "type": "integer",
      "const": 1
    },
    "missao_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["planejado", "planejado-com-restricoes", "negado", "incompleto"]
    },
    "papel_principal": {
      "type": ["string", "null"]
    },
    "papeis_auxiliares": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "ferramenta_selecionada": {
      "type": ["string", "null"]
    },
    "adaptador_selecionado": {
      "type": ["string", "null"]
    },
    "skills_selecionadas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fluxo_selecionado": {
      "type": ["string", "null"]
    },
    "autorizacao_fornecida": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]
    },
    "autorizacao_necessaria": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]
    },
    "leitura_permitida": {
      "type": "boolean"
    },
    "escrita_permitida": {
      "type": "boolean"
    },
    "shell_permitido": {
      "type": "boolean"
    },
    "rede_permitida": {
      "type": "boolean"
    },
    "delegacao_permitida": {
      "type": "boolean"
    },
    "etapas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nome", "papel", "acao"],
        "properties": {
          "nome": { "type": "string" },
          "papel": { "type": "string" },
          "acao": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "ferramenta": { "type": "string" }
        }
      }
    },
    "condicoes_parada": {
      "type": "array",
      "description": "União das condições do Cartão (ordem preservada) com as condições operacionais padrão do planner (comandos_concluidos, alteracao_fora_do_escopo, tempo_excedido, agente_nao_planejado). Duplicatas são removidas sem sort alfabético.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidencias_requeridas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "negacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo", "mensagem"],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$"
          },
          "mensagem": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "avisos": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fontes_decisao": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "acoes_solicitadas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "acoes_permitidas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "comandos": {
      "type": "array",
      "description": "IDs do catálogo do executor. Plano analítico (leitores) pode ser planejado com lista vazia e resumo_operacional.executavel=false — não enviar ao run-agent-mission. Missão executor-escopo/com escrita exige comandos não vazios no planner; senão status=negado (PLANEJADO_REQUIRES_COMMANDS). Propagados sem ampliação nem sort alfabético.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "resumo_operacional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "estrategia",
        "agentes_planejados",
        "max_paralelo",
        "writers",
        "risco",
        "requer_aprovacao",
        "executavel"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "const": "codex-cli"
        },
        "estrategia": {
          "type": "string",
          "enum": ["agente-unico", "multiagente"]
        },
        "agentes_planejados": {
          "type": "integer",
          "minimum": 0
        },
        "max_paralelo": {
          "type": "integer",
          "minimum": 1
        },
        "writers": {
          "type": "integer",
          "minimum": 0
        },
        "risco": {
          "type": "string",
          "enum": ["baixo", "medio", "alto"]
        },
        "requer_aprovacao": {
          "type": "boolean"
        },
        "executavel": {
          "type": "boolean",
          "description": "true somente se planejado + executor-escopo + comandos não vazios + sem negações. Planos analíticos usam false e não devem ser enviados ao run-agent-mission."
        }
      }
    },
    "topologia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agentes", "max_profundidade", "permite_subdelegacao", "agentes"],
      "properties": {
        "max_agentes": {
          "type": "integer",
          "minimum": 0
        },
        "max_profundidade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "permite_subdelegacao": {
          "type": "boolean"
        },
        "agentes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "papel", "permissao", "depende_de"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "papel": { "type": "string", "minLength": 1 },
              "permissao": {
                "type": "string",
                "enum": ["read-only", "workspace-write"]
              },
              "depende_de": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "simplicidade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avaliada",
        "multiagente_necessario",
        "justificativa_multiagente",
        "reutiliza_existente",
        "nova_dependencia",
        "nova_abstracao"
      ],
      "properties": {
        "avaliada": {
          "type": "boolean",
          "description": "false nesta fase: campos de reutilização/dependência/abstração são intenção/default, não fatos observados. Avaliação automática fica para 3B.2B."
        },
        "multiagente_necessario": { "type": "boolean" },
        "justificativa_multiagente": { "type": ["string", "null"] },
        "reutiliza_existente": { "type": "boolean" },
        "nova_dependencia": { "type": "boolean" },
        "nova_abstracao": { "type": "boolean" }
      }
    },
    "limites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retentativas", "max_rodadas_revisao"],
      "properties": {
        "max_retentativas": { "type": "integer", "minimum": 0 },
        "max_rodadas_revisao": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
