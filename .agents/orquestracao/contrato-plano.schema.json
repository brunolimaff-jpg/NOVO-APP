{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novo-app.local/.agents/orquestracao/contrato-plano.schema.json",
  "title": "Contrato do Plano de Execução",
  "description": "Saída determinística do planejador de missões (Fase 3B.2B: estratégia explícita + tarefas planejadas).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "missao_id",
    "status",
    "papel_principal",
    "ferramenta_selecionada",
    "adaptador_selecionado",
    "skills_selecionadas",
    "autorizacao_fornecida",
    "autorizacao_necessaria",
    "leitura_permitida",
    "escrita_permitida",
    "shell_permitido",
    "rede_permitida",
    "delegacao_permitida",
    "etapas",
    "condicoes_parada",
    "evidencias_requeridas",
    "negacoes",
    "avisos",
    "fontes_decisao",
    "acoes_solicitadas",
    "acoes_permitidas",
    "comandos",
    "resumo_operacional",
    "decisao_execucao",
    "topologia",
    "tarefas_planejadas",
    "simplicidade",
    "limites"
  ],
  "properties": {
    "versao": {
      "type": "integer",
      "const": 1
    },
    "missao_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["planejado", "planejado-com-restricoes", "negado", "incompleto"]
    },
    "papel_principal": {
      "type": ["string", "null"]
    },
    "papeis_auxiliares": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "ferramenta_selecionada": {
      "type": ["string", "null"]
    },
    "adaptador_selecionado": {
      "type": ["string", "null"]
    },
    "skills_selecionadas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fluxo_selecionado": {
      "type": ["string", "null"]
    },
    "autorizacao_fornecida": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]
    },
    "autorizacao_necessaria": {
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]
    },
    "leitura_permitida": {
      "type": "boolean"
    },
    "escrita_permitida": {
      "type": "boolean"
    },
    "shell_permitido": {
      "type": "boolean"
    },
    "rede_permitida": {
      "type": "boolean"
    },
    "delegacao_permitida": {
      "type": "boolean"
    },
    "etapas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nome", "papel", "acao"],
        "properties": {
          "nome": { "type": "string" },
          "papel": { "type": "string" },
          "acao": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "ferramenta": { "type": "string" }
        }
      }
    },
    "condicoes_parada": {
      "type": "array",
      "description": "União das condições do Cartão (ordem preservada) com as condições operacionais padrão do planner.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidencias_requeridas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "negacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo", "mensagem"],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$"
          },
          "mensagem": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "avisos": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fontes_decisao": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "acoes_solicitadas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "acoes_permitidas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "comandos": {
      "type": "array",
      "description": "IDs do catálogo do executor. Plano analítico pode ser planejado com lista vazia e resumo_operacional.executavel=false.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "decisao_execucao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estrategia",
        "origem",
        "motivo",
        "justificativa_multiagente",
        "ganho_esperado",
        "perfil_execucao",
        "gate_qualidade"
      ],
      "properties": {
        "estrategia": {
          "type": "string",
          "enum": ["agente-unico", "multiagente"]
        },
        "origem": {
          "type": "string",
          "enum": ["default", "cartao"]
        },
        "motivo": { "type": "string", "minLength": 1 },
        "justificativa_multiagente": { "type": ["string", "null"] },
        "ganho_esperado": { "type": ["string", "null"] },
        "perfil_execucao": {
          "type": "string",
          "enum": ["minimal-change", "padrao"]
        },
        "gate_qualidade": {
          "type": "string",
          "enum": ["evidence-first", "padrao"]
        }
      }
    },
    "resumo_operacional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "estrategia",
        "agentes_planejados",
        "max_paralelo",
        "writers",
        "risco",
        "requer_aprovacao",
        "executavel"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "const": "codex-cli"
        },
        "estrategia": {
          "type": "string",
          "enum": ["agente-unico", "multiagente"]
        },
        "agentes_planejados": {
          "type": "integer",
          "minimum": 0
        },
        "max_paralelo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "writers": {
          "type": "integer",
          "minimum": 0
        },
        "risco": {
          "type": "string",
          "enum": ["baixo", "medio", "alto"]
        },
        "requer_aprovacao": {
          "type": "boolean"
        },
        "executavel": {
          "type": "boolean"
        }
      }
    },
    "topologia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_agentes", "max_profundidade", "permite_subdelegacao", "agentes"],
      "properties": {
        "max_agentes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_profundidade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "permite_subdelegacao": {
          "type": "boolean"
        },
        "agentes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "papel", "permissao", "depende_de"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "papel": { "type": "string", "minLength": 1 },
              "permissao": {
                "type": "string",
                "enum": ["read-only", "workspace-write"]
              },
              "depende_de": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "tarefas_planejadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agente", "objetivo", "entrega_esperada", "nao_fazer", "arquivos", "depende_de"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "agente": { "type": "string", "minLength": 1 },
          "objetivo": { "type": "string", "minLength": 1 },
          "entrega_esperada": { "type": "string", "minLength": 1 },
          "nao_fazer": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "arquivos": {
            "type": "object",
            "additionalProperties": false,
            "required": ["leitura", "escrita"],
            "properties": {
              "leitura": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "escrita": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          },
          "depende_de": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "simplicidade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avaliada",
        "multiagente_necessario",
        "justificativa_multiagente",
        "reutiliza_existente",
        "nova_dependencia",
        "nova_abstracao"
      ],
      "properties": {
        "avaliada": {
          "type": "boolean",
          "description": "true somente quando o cartão declara reutiliza_existente, nova_dependencia e nova_abstracao."
        },
        "multiagente_necessario": { "type": "boolean" },
        "justificativa_multiagente": { "type": ["string", "null"] },
        "reutiliza_existente": { "type": "boolean" },
        "nova_dependencia": { "type": "boolean" },
        "nova_abstracao": { "type": "boolean" }
      }
    },
    "limites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retentativas", "max_rodadas_revisao", "max_tempo_segundos"],
      "properties": {
        "max_retentativas": { "type": "integer", "minimum": 0, "maximum": 1 },
        "max_rodadas_revisao": { "type": "integer", "minimum": 0, "maximum": 1 },
        "max_tempo_segundos": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["status", "resumo_operacional"],
        "properties": {
          "status": { "const": "planejado" },
          "resumo_operacional": {
            "type": "object",
            "required": ["executavel"],
            "properties": {
              "executavel": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comandos": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["resumo_operacional"],
        "properties": {
          "resumo_operacional": {
            "type": "object",
            "required": ["executavel"],
            "properties": {
              "executavel": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "comandos": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": ["negado", "incompleto", "planejado-com-restricoes"]
          }
        }
      },
      "then": {
        "properties": {
          "comandos": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
